---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const [entry] = await getCollection('mappings');
const { Content } = await render(entry);
---

<BaseLayout title="Mappings" description="Cross-walk tables: DoD ZT RA 2.0, NIST SP 800-207, CISA ZTMM, and industry compliance frameworks.">
  <section>
    <div class="wrap">
      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
