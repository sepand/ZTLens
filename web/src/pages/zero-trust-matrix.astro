---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = (await getCollection('nistCrosswalk')).sort((a, b) => a.data.order - b.data.order);
const capabilities = (await getCollection('capabilities')).map((c) => ({ id: c.id, pillar: c.data.pillar }));
const base = import.meta.env.BASE_URL;

const vendorEntries = await getCollection('vendors');
const vendorsByPillar = Object.fromEntries(vendorEntries.map((v) => [v.data.pillar, v.data.vendors]));
const vendorMeta = vendorEntries[0]?.data ?? { generated_at: new Date().toISOString(), sources: [], disclaimer: '' };

const SOURCE_LABELS: Record<string, string> = {
  'aws-marketplace': 'AWS Marketplace',
  'azure-marketplace': 'Azure Marketplace',
  'gcp-marketplace-manual': 'GCP Marketplace (manually curated)',
};
const sourceLabel = (id: string) => SOURCE_LABELS[id] || id;

const functions = [
  { key: 'govern', label: 'Govern', code: 'GV', var: '--fn-govern' },
  { key: 'identify', label: 'Identify', code: 'ID', var: '--fn-identify' },
  { key: 'protect', label: 'Protect', code: 'PR', var: '--fn-protect' },
  { key: 'detect', label: 'Detect', code: 'DE', var: '--fn-detect' },
  { key: 'respond', label: 'Respond', code: 'RS', var: '--fn-respond' },
  { key: 'recover', label: 'Recover', code: 'RC', var: '--fn-recover' },
];

const functionInfo = [
  { label: 'Govern (GV)', desc: "Establishes and monitors the organization's cybersecurity risk management strategy, expectations, and policy." },
  { label: 'Identify (ID)', desc: 'Understands current cybersecurity risk to systems, assets, data, and capabilities.' },
  { label: 'Protect (PR)', desc: 'Implements safeguards to manage risk and limit or contain the impact of events.' },
  { label: 'Detect (DE)', desc: 'Finds and analyzes possible cybersecurity attacks and compromises.' },
  { label: 'Respond (RS)', desc: 'Takes action regarding a detected cybersecurity incident.' },
  { label: 'Recover (RC)', desc: 'Restores assets and operations affected by a cybersecurity incident.' },
];
---

<BaseLayout
  title="Zero Trust × NIST CSF Crosswalk"
  description="DoD Zero Trust Reference Architecture 2.0 pillars mapped against the six NIST CSF 2.0 functions."
>
  <section>
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Crosswalk</span>
        <h2>Zero Trust × NIST CSF 2.0 Crosswalk</h2>
        <p>
          Maps the <a href={`${base}/pillars`}>DoD ZT RA 2.0 pillars</a>
          against the six
          <a href="https://www.nist.gov/cyberframework" target="_blank" rel="noopener">NIST Cybersecurity Framework 2.0</a>
          functions: Govern, Identify, Protect, Detect, Respond, Recover.
          Each cell lists illustrative capabilities, not an exhaustive control set.
        </p>
        <p class="text-muted" id="cw-maturity-note" style="display:none; font-size:0.85rem; margin-top:12px;">
          The dot next to each pillar reflects your saved
          <a href={`${base}/assessment`}>self-assessment</a> maturity for that pillar.
        </p>
      </div>

      <div class="crosswalk-toolbar">
        <div class="view-toggle" role="group" aria-label="Table view">
          <button type="button" class="view-toggle-btn active" data-view-btn="capabilities">Capabilities</button>
          <button type="button" class="view-toggle-btn" data-view-btn="vendors">Vendors</button>
        </div>
        <span class="text-muted" id="vendor-meta-note" style="font-size:0.8rem; display:none;">
          Vendors last synced {new Date(vendorMeta.generated_at).toLocaleDateString()} from {vendorMeta.sources.length ? vendorMeta.sources.map(sourceLabel).join(', ') : 'no configured source yet'}. {vendorMeta.disclaimer}
        </span>
      </div>

      <div class="crosswalk-scroll">
        <table class="crosswalk" id="crosswalk-table" data-view="capabilities">
          <thead>
            <tr>
              <th class="pillar-col">Pillar</th>
              {functions.map((f) => (
                <th class="fn-col" style={`--fn-color: var(${f.var})`}>{f.label}</th>
              ))}
              <th class="vendor-cell vendor-head">Identified vendors</th>
            </tr>
          </thead>
          <tbody>
            {pillars.map((p) => {
              const pillarVendors = vendorsByPillar[p.data.dod_pillar] || [];
              return (
                <tr>
                  <td class="pillar-col">
                    {p.data.dod_pillar}
                    <span class="cw-maturity-dot" id={`cw-dot-${p.id}`} title="Not yet assessed"></span>
                  </td>
                  {functions.map((f) => {
                    const items = p.data.cells[f.key]
                      .split(';')
                      .map((s) => s.trim())
                      .filter(Boolean);
                    return (
                      <td class="fn-cell" style={`--fn-color: var(${f.var})`}>
                        <div class="cw-chip-list">
                          {items.map((item) => (
                            <span class="cw-chip">{item}</span>
                          ))}
                        </div>
                      </td>
                    );
                  })}
                  <td class="vendor-cell">
                    {pillarVendors.length > 0 ? (
                      <div class="cw-chip-list" style="flex-direction:row; flex-wrap:wrap;">
                        {pillarVendors.map((v) =>
                          v.url ? (
                            <a class="cw-chip vendor-chip" href={v.url} target="_blank" rel="noopener" title={`${v.name} — via ${sourceLabel(v.source)}`}>{v.publisher}</a>
                          ) : (
                            <span class="cw-chip vendor-chip" title={`${v.name} — via ${sourceLabel(v.source)}`}>{v.publisher}</span>
                          )
                        )}
                      </div>
                    ) : (
                      <span class="text-muted" style="font-size:0.82rem;">No vendors identified yet</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div style="margin-top: 56px;">
        <h2 style="font-size:1.3rem; margin-bottom:20px;">About the NIST CSF 2.0 functions</h2>
        <div class="grid grid-3">
          {functionInfo.map((f) => (
            <div class="card">
              <h3 style="margin:0 0 8px; font-size:1rem;">{f.label}</h3>
              <p class="text-muted" style="margin:0; font-size:0.9rem;">{f.desc}</p>
            </div>
          ))}
        </div>
        <p class="text-muted" style="margin-top:20px; font-size:0.85rem;">
          Source: <a href="https://nvlpubs.nist.gov/nistpubs/CSWP/NIST.CSWP.29.pdf" target="_blank" rel="noopener">NIST Cybersecurity Framework 2.0 (NIST CSWP 29)</a>.
        </p>
      </div>
    </div>
  </section>

  <script is:inline src={`${base}/assessment.js`}></script>
  <script define:vars={{ capabilities, pillarRows: pillars.map((p) => ({ id: p.id, dodPillar: p.data.dod_pillar })) }}>
    (function () {
      var engine = window.ZTLensAssessment;
      if (!engine) return;
      var scores = engine.pillarScores(capabilities);
      var anyAssessed = false;
      pillarRows.forEach(function (row) {
        var s = scores[row.dodPillar];
        var dot = document.getElementById('cw-dot-' + row.id);
        if (!dot) return;
        if (s && s.score !== null) {
          anyAssessed = true;
          var stage = engine.nearestStage(s.score);
          dot.classList.add('cw-dot-' + stage);
          dot.title = 'Your maturity: ' + engine.STAGE_LABELS[stage] + ' (' + s.score.toFixed(1) + '/3, ' + s.answered + '/' + s.total + ' assessed)';
        }
      });
      if (anyAssessed) {
        var note = document.getElementById('cw-maturity-note');
        if (note) note.style.display = 'block';
      }
    })();
  </script>

  <script is:inline>
    (function () {
      var table = document.getElementById('crosswalk-table');
      var buttons = document.querySelectorAll('[data-view-btn]');
      var vendorMetaNote = document.getElementById('vendor-meta-note');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var view = btn.getAttribute('data-view-btn');
          table.setAttribute('data-view', view);
          buttons.forEach(function (b) { b.classList.toggle('active', b === btn); });
          if (vendorMetaNote) vendorMetaNote.style.display = view === 'vendors' ? 'inline' : 'none';
        });
      });
    })();
  </script>
</BaseLayout>
